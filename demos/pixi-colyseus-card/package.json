{
  "name": "pixi-colyseus-card",
  "version": "1.0.0",
  "description": "PixiJS + Colyseus 卡牌比大小最小範例（技術驗證用）",
  "scripts": {
    "assets": "node tools/fetch-spine.mjs && python tools/make_wav.py public/assets/reveal.wav",
    "server": "tsx server/index.ts",
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test:e2e": "node tests/e2e.mjs",
    "cap:android": "npx cap add android && npx cap sync android",
    "test:bundle": "node tests/check-bundle.mjs",
    "build:e2e": "vite build --mode e2e"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@colyseus/core": "^0.18.18",
    "@colyseus/schema": "^5.0.36",
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/ws-transport": "^0.18.4",
    "@esotericsoftware/spine-pixi-v8": "^4.3.13",
    "@pixi/layout": "^3.2.1",
    "@pixi/sound": "^6.0.1",
    "@pixi/ui": "^2.4.1",
    "gsap": "^3.15.0",
    "pixi.js": "^8.22.0",
    "xstate": "^5.33.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "private": true
}
